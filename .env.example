# Public canonical URL used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional WordPress companion: public news/people/courses/events/volunteer APIs only, no admin password.
# Local editor: npm run dev:cms, then npm run dev:with-cms.
# WORDPRESS_CMS_URL=http://127.0.0.1:9400
# Production must use HTTPS. GitHub Pages reads a snapshot during the build.
# WORDPRESS_CMS_URL=https://cms.your-existing-domain.example

# Optional absolute directory for the local JSON operations store.
# Leave unset to use .data/ inside the project.
# LOCAL_DATA_DIR=C:\path\to\persistent-data

# Cancelled registrations and resolved contacts are removed after this period.
LOCAL_DATA_RETENTION_DAYS=30

# Email delivery is configured on the server, never through NEXT_PUBLIC_ keys.
# FORM_NOTIFICATION_TRANSPORT=smtp
# SMTP_HOST=your-existing-mail-server
# SMTP_PORT=465
# SMTP_USER=website@example.org
# SMTP_PASSWORD=replace-with-a-server-secret
# SMTP_FROM=website@example.org
# Port 465 uses implicit TLS; other SMTP ports require STARTTLS.
# FORM_RECIPIENT_DEFAULT=kontakt@sonnenblume-mg.com
# FORM_RECIPIENT_COURSES=kurse@sonnenblume-mg.com
# FORM_RECIPIENT_EVENTS=kurse@sonnenblume-mg.com
# FORM_RECIPIENT_REGISTRATION=kurse@sonnenblume-mg.com
# FORM_RECIPIENT_VOLUNTEERING=vorstand@sonnenblume-mg.com
# FORM_RECIPIENT_MEMBERSHIP=vorstand@sonnenblume-mg.com
# FORM_RECIPIENT_DONATION=vorstand@sonnenblume-mg.com
# FORM_RECIPIENT_PARTNERSHIP=vorstand@sonnenblume-mg.com
# PUBLIC_FORM_ORIGINS=https://garuday.github.io

# Only on the existing Cloudflare/Sites runtime with the DB binding provisioned:
# HOSTED_DEMO=true
