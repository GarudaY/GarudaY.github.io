    "test:operations": "node scripts/smoke-operations.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.24.0",
    "next": "^16.2.12",
    "nodemailer": "^9.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.9.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.115.0"
  }
